---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/urls';

const published = (await getCollection('guides', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Guides: Shopify chargebacks, blocklists & fraud prevention"
	description="Practical Blox guides on chargeback blacklists, blocking repeat chargeback customers, serial returners, refund abuse, and when to use a blocklist vs a fraud filter."
>
	<section class="section guides">
		<div class="site-wrap">
			<span class="section-label">Guides</span>
			<h1 class="section-title">Fraud prevention playbooks</h1>
			<p class="section-lead">
				What a chargeback blacklist does, how Shopify merchants use one to stop serial
				returners and refund abuse, and when a fraud filter is the better fit.
			</p>
			<ul class="guide-list">
				{
					published.map((guide) => (
						<li>
							<a href={withBase(`guides/${guide.id}/`)}>{guide.data.title}</a>
							<p>{guide.data.description}</p>
						</li>
					))
				}
			</ul>
			<p class="guides__compare">
				Also see:{' '}
				<a href={withBase('compare/')}>Blox vs NoFraud, Signifyd, and Blockify</a>
				{' · '}
				<a href={withBase('faq/')}>FAQ</a>
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.guides {
		padding-top: 4rem;
		min-height: 50vh;
	}

	.guide-list {
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1.5rem;
	}

	.guide-list a {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		text-decoration: none;
	}

	.guide-list p {
		margin-top: 0.35rem;
		color: var(--color-fg-muted);
	}

	.guides__compare {
		margin-top: 2.5rem;
		color: var(--color-fg-muted);
		font-size: 0.95rem;
	}

	.guides__compare a {
		color: var(--color-fg);
		text-decoration: none;
	}

	.guides__compare a:hover {
		color: var(--color-red);
	}
</style>
