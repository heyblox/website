---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { withBase } from '../lib/urls';

const appStoreUrl = 'https://apps.shopify.com/blocklist';

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: 'Blox',
		url: 'https://heyblox.com',
		logo: 'https://heyblox.com/logo.png',
		email: 'privacy@heyblox.com',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Blox: Chargeback Blacklist',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Shopify',
		url: 'https://heyblox.com',
		downloadUrl: appStoreUrl,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD',
		},
		description:
			'Stop fraudulent customers using our community blocklist. Block by email, phone, address, or payment. When one store flags fraud, all stores are protected.',
	},
];
---

<BaseLayout
	title="Blox: Chargeback Blacklist for Shopify"
	description="Block fraudsters once. We’ll handle the rest. Shopify fraud prevention with a community blocklist. Stop chargebacks, serial returners, and refund abuse before fulfillment."
	jsonLd={jsonLd}
>
	<Hero />

	<section class="section problem" aria-labelledby="problem-heading">
		<div class="site-wrap">
			<span class="section-label">Stop abuse before it spreads</span>
			<h2 id="problem-heading" class="section-title">
				Blox stops the customers who defraud you.
			</h2>
			<p class="section-lead">
				Block repeat fraudsters, prevent chargebacks, and stop refund abusers before they
				place another order. Cancel high-risk orders before fulfillment, so trouble doesn’t
				reach your warehouse or your processor.
			</p>
		</div>
	</section>

	<section class="section how" id="how-it-works" aria-labelledby="how-heading">
		<div class="site-wrap how__grid">
			<div class="how__copy">
				<span class="section-label">Blocked once, blocked everywhere</span>
				<h2 id="how-heading" class="section-title">
					A merchant-powered blocklist.
				</h2>
				<p class="section-lead">
					When one store flags fraud, all stores are protected. Customers are
					deduplicated. Simple rules. No AI black box. No per-transaction fees.
				</p>
				<ol class="how__steps">
					<li>
						<strong>Block by email, phone, address, or payment</strong>
						<span>Easily block any customer without complex fraud rules.</span>
					</li>
					<li>
						<strong>Stop duplicate accounts</strong>
						<span>Auto-group customers with multiple accounts: different emails, same person.</span>
					</li>
					<li>
						<strong>Shared network protection</strong>
						<span>Any customer blocked on another store is flagged for you to review. Hold chargeback abusers before they hit you.</span>
					</li>
				</ol>
			</div>
			<figure class="how__visual">
				<img
					src={withBase('identity-network.jpg')}
					alt="Network diagram showing Blox linking customer identities across emails, addresses, and accounts"
					width="1536"
					height="1024"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	<section class="section trust" aria-labelledby="trust-heading">
		<div class="site-wrap trust__inner">
			<img class="trust__mark" src={withBase('logo-512.png')} alt="" width="48" height="48" />
			<span class="section-label">From merchants on Shopify</span>
			<blockquote class="trust__quote" id="trust-heading">
				<p>
					“Looooove blox. We have a huge issue dealing with a ton of return fraud/abuse
					as well as weird customer behavior. Been using Blox to find unprofitable or
					problematic customers and cut them out of our customer file to save us the
					operational and financial headache.”
				</p>
				<footer>
					<cite>Sozy</cite>
				</footer>
			</blockquote>
			<p class="section-lead">
				Hold or auto-cancel high-risk orders, discover your worst customers, and auto-block
				blacklisted shoppers, with a free plan and 30-day trial on paid plans.
			</p>
			<p class="trust__more">
				<a href={withBase('guides/how-to-block-a-customer-on-shopify/')}>
					How to block a customer on Shopify
				</a>
			</p>
		</div>
	</section>

	<section class="section cta" aria-labelledby="cta-heading">
		<div class="site-wrap cta__inner">
			<h2 id="cta-heading" class="section-title">Block fraudsters once.</h2>
			<p class="section-lead">
				Install Blox from the Shopify App Store and turn every block into shared
				protection.
			</p>
			<a class="btn" href={appStoreUrl} rel="noopener noreferrer">
				Install on Shopify
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.problem {
		border-bottom: 1px solid var(--color-border);
	}

	.how {
		border-bottom: 1px solid var(--color-border);
		background: linear-gradient(180deg, var(--color-bg) 0%, #090909 100%);
	}

	.how__grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.how__steps {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}

	.how__steps li {
		display: grid;
		gap: 0.35rem;
		padding-left: 1rem;
		border-left: 2px solid var(--color-red);
	}

	.how__steps strong {
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.how__steps span {
		color: var(--color-fg-muted);
	}

	.how__visual {
		margin: 0;
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: #000;
	}

	.how__visual img {
		width: 100%;
		height: auto;
		opacity: 0.95;
	}

	.trust {
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.trust__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.trust__mark {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		border: 1px solid var(--color-ring);
		margin-bottom: 1.25rem;
	}

	.trust .section-title,
	.trust .section-lead {
		margin-inline: auto;
		text-align: center;
	}

	.trust__quote {
		margin: 0 0 1.5rem;
		max-width: 38rem;
	}

	.trust__quote p {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.6vw, 1.65rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.35;
	}

	.trust__quote footer {
		margin-top: 1rem;
		color: var(--color-fg-muted);
		font-size: 0.95rem;
	}

	.trust__quote cite {
		font-style: normal;
	}

	.trust__more {
		margin-top: 1.5rem;
		font-size: 0.95rem;
	}

	.trust__more a {
		color: var(--color-fg);
		text-decoration: none;
		border-bottom: 1px solid var(--color-border);
	}

	.trust__more a:hover {
		color: var(--color-red);
		border-color: var(--color-red);
	}

	.cta {
		padding-block: 6rem;
		text-align: center;
		background:
			radial-gradient(ellipse 55% 70% at 50% 100%, rgba(252, 0, 0, 0.16), transparent 65%),
			var(--color-bg);
	}

	.cta__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
	}

	.cta .section-title {
		max-width: 12ch;
	}

	.cta .section-lead {
		margin-bottom: 1.75rem;
		text-align: center;
	}

	@media (min-width: 900px) {
		.how__grid {
			grid-template-columns: 1fr 1.05fr;
			gap: 3.5rem;
		}
	}
</style>
