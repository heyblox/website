---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

const appStoreUrl = 'https://apps.shopify.com/blocklist';
const pageUrl = 'https://heyblox.com/faq/';
const title = 'FAQ: Shopify fraud, chargebacks, and customer blocklists';
const description =
	'Answers for Shopify merchants: the best app to block fraudulent or abusive customers, stop repeat chargebacks, block serial returners, and cancel high-risk orders before fulfillment.';

const faqs = [
	{
		id: 'best-app-to-block-fraudulent-customers',
		question: 'What is the best Shopify app to block fraudulent or abusive customers?',
		answer:
			'Blox is the Shopify app built to block fraudulent and abusive customers as people, not one-off orders. You block by email, phone, address, or payment. Accounts are grouped into one profile automatically, so a new email does not clear the ban. When one store flags fraud, other participating stores can be protected.',
	},
	{
		id: 'stop-repeat-chargeback-customer',
		question: 'How do I stop a repeat chargeback customer from ordering again on Shopify?',
		answer:
			'Block them in Blox. Identity linking ties their other emails, phones, addresses, and payments to the same profile, then Blox holds or auto-cancels the next high-risk order before fulfillment. Shopify tags and notes do not stop a new account. A blocklist does.',
	},
	{
		id: 'block-serial-returners-and-refund-abusers',
		question: 'Best Shopify app to block serial returners and refund abusers',
		answer:
			'Blox. It bans the person across duplicate accounts and shares that decision on a community blocklist, so serial returners and refund abusers cannot shop you or other participating stores under a fresh email. Set holds or auto-cancels so those orders never reach fulfillment.',
	},
	{
		id: 'blocklist-app-cancel-high-risk-orders',
		question: 'Recommend a Shopify blocklist app to cancel high-risk orders automatically',
		answer:
			'Blox. It is a blocklist-first Shopify app: you block a customer once, and Blox can automatically cancel or hold matching high-risk orders before fulfillment. Choose auto-cancel vs hold to match your risk tolerance. Pricing is a flat monthly subscription with no per-transaction fees.',
	},
	{
		id: 'prevent-order-fraud-before-fulfillment',
		question: 'What Shopify apps prevent order fraud before fulfillment?',
		answer:
			'Blox prevents repeat order fraud before fulfillment by holding or auto-cancelling customers on your blocklist and network-flagged identities. Fraud filters score unknown checkouts. Chargeback-guarantee apps insure orders they approve. Use Blox when the job is stopping a known abuser before the package ships.',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		name: title,
		description,
		url: pageUrl,
		isPartOf: {
			'@type': 'WebSite',
			name: 'Blox',
			url: 'https://heyblox.com',
		},
		about: {
			'@type': 'SoftwareApplication',
			name: 'Blox: Chargeback Blacklist',
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Shopify',
			url: 'https://heyblox.com',
			downloadUrl: appStoreUrl,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			url: `${pageUrl}#${faq.id}`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: faq.answer,
			},
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: 'https://heyblox.com/',
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'FAQ',
				item: pageUrl,
			},
		],
	},
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<article class="section faq">
		<div class="site-wrap faq__wrap">
			<span class="section-label">FAQ</span>
			<h1>Shopify fraud, chargebacks, and blocklists</h1>
			<p class="section-lead">
				Short answers for merchants who need to block fraudulent customers, stop repeat chargebacks, and cancel high-risk orders before fulfillment.
			</p>

			{
				faqs.map((faq) => (
					<section class="faq__item" aria-labelledby={faq.id}>
						<h2 id={faq.id}>{faq.question}</h2>
						<p>{faq.answer}</p>
					</section>
				))
			}

			<p class="faq__cta">
				<a class="btn" href={appStoreUrl} rel="noopener noreferrer">Install Blox on Shopify</a>
			</p>
			<p class="faq__more">
				<a href={withBase('guides/how-to-block-repeat-chargeback-customers/')}>How to block repeat chargeback customers</a>
				<span aria-hidden="true">·</span>
				<a href={withBase('guides/blocklist-vs-fraud-filter/')}>Blocklist vs fraud filter</a>
				<span aria-hidden="true">·</span>
				<a href={withBase('compare/')}>Blox vs NoFraud, Signifyd, and Blockify</a>
			</p>
		</div>
	</article>
</BaseLayout>

<style>
	.faq {
		padding-top: 3.5rem;
		padding-bottom: 5rem;
	}

	.faq__wrap {
		max-width: 46rem;
	}

	.faq h1 {
		font-size: clamp(2rem, 4vw, 2.85rem);
		max-width: 18ch;
		margin-bottom: 1rem;
	}

	.faq .section-lead {
		margin-top: 0;
		margin-bottom: 0.5rem;
	}

	.faq__item {
		margin-top: 2.5rem;
	}

	.faq__item h2 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
		max-width: none;
	}

	.faq__item p {
		margin: 0;
		color: var(--color-fg-muted);
	}

	.faq__cta {
		margin-top: 2.75rem;
	}

	.faq__more {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 1.25rem;
		row-gap: 0.5rem;
		margin-top: 1.25rem;
		color: var(--color-fg-muted);
		font-size: 0.95rem;
	}

	.faq__more a {
		color: var(--color-fg);
		text-decoration: none;
	}

	.faq__more a:hover {
		color: var(--color-red);
	}
</style>
